{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "WhatsRB Cloud",
  "description": "The easiest way to integrate the official WhatsApp Business API.",
  "colors": {
    "primary": "#22C55E",
    "light": "#4ADE80",
    "dark": "#16A34A"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png",
    "href": "https://whatsrb.com"
  },
  "favicon": "/images/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "GitLab",
        "href": "https://gitlab.com/whatsrb/sdk-ruby"
      },
      {
        "label": "Need help?",
        "href": "mailto:contact@whatsrb.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://whatsrb.com/login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "guides/quickstart",
              "guides/authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "guides/webhooks",
              "guides/templates",
              "guides/meta-webhook-setup",
              "guides/error-handling"
            ]
          },
          {
            "group": "Widget",
            "pages": [
              "guides/widget"
            ]
          },
          {
            "group": "Agent & Workflows",
            "pages": [
              "guides/agents-overview",
              "guides/allowed-actions",
              "guides/structured-fields",
              "guides/conversation-context",
              "guides/human-takeover"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview", "api-reference/quickstart"]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "code",
        "menu": [
          {
            "item": "Overview",
            "icon": "book-open",
            "pages": ["sdks/overview"]
          },
          {
