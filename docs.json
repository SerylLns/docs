              "sdks/python/sessions",
              "sdks/python/agents",
              "sdks/python/webhooks",
              "sdks/python/registries"
            ]
          },
          {
            "item": "Ruby",
            "icon": "gem",
            "description": "gem install whatsrb_cloud",
            "pages": [
              "sdks/ruby/overview",
              "sdks/ruby/installation",
              "sdks/ruby/configuration",
              "sdks/ruby/business-accounts",
              "sdks/ruby/business-messages",
              "sdks/ruby/templates",
              "sdks/ruby/sessions",
              "sdks/ruby/agents",
              "sdks/ruby/webhooks",
              "sdks/ruby/registries"
            ]
          },
          {
