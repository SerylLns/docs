{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "WhatsRB Cloud",
  "description": "The easiest way to integrate the official WhatsApp Business API in Ruby.",
  "colors": {
    "primary": "#22C55E",
    "light": "#4ADE80",
    "dark": "#16A34A"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png",
    "href": "https://whatsrb.com"
  },
  "favicon": "/images/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/SerylLns/whatsrb-sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://whatsrb.com/login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "guides/quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "guides/authentication",
              "guides/webhooks",
              "guides/meta-webhook-setup",
              "guides/error-handling"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview", "api-reference/quickstart"]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "code",
        "groups": [
          {
            "group": "Ruby",
            "pages": [
              "sdks/ruby/overview",
              "sdks/ruby/installation",
              "sdks/ruby/configuration"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "sdks/ruby/business-accounts",
              "sdks/ruby/business-messages",
              "sdks/ruby/templates",
              "sdks/ruby/sessions",
              "sdks/ruby/webhooks"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/SerylLns/whatsrb-sdk"
    }
  }
}
